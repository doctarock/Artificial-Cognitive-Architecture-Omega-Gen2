# omega-acad configuration. Copy this file to `.env` in the same directory
# as the executable and edit the values you want — everything below is
# optional. With nothing set at all, omega-acad still runs: it creates a
# fresh local database, listens on 127.0.0.1:8787, and uses harmless
# built-in fallbacks (a deterministic embedding stub, a placeholder Tier 3
# reply) instead of real models, so you can see it come up before wiring in
# any model server of your own.
#
# Real environment variables, if set, always take precedence over anything
# in this file.

# --- Core ---
# Where the SQLite database lives. Created fresh on first run if it doesn't
# exist yet — this is *your* data, never shared with anyone else's install.
OMEGA_DB_PATH=./omega.sqlite3
# The local HTTP+WebSocket API the viz app (and anything else) talks to.
OMEGA_API_PORT=8787
# The household/LAN-facing MCP surface (Knowledge Library read/write,
# send-input, snapshot) for other agents/devices to reach. Bound to
# 0.0.0.0 by default — change to 127.0.0.1 if you only want it reachable
# from this machine.
OMEGA_MCP_PORT=8788
OMEGA_MCP_HOST=0.0.0.0
# The Operator::Act trust dial: "harmless" (default, no external side
# effects), "reversible", or "consequential". Only harmless-tier tools
# exist today, so this is safe to leave alone.
OMEGA_MAX_TOOL_RISK_TIER=harmless

# --- Embedding tier (Tier 0 — called on every input, keep it cheap) ---
# Point this at any Ollama-compatible embedding endpoint you run yourself,
# or an OpenAI-compatible one (set OMEGA_EMBEDDING_PROVIDER=openai and
# OMEGA_EMBEDDING_API_KEY). Leave unset to use the built-in deterministic
# fallback instead of a real model.
# OMEGA_EMBEDDING_PROVIDER=ollama
# OMEGA_EMBEDDING_BASE_URL=http://localhost:11434
# OMEGA_EMBEDDING_MODEL=mxbai-embed-large
# OMEGA_EMBEDDING_API_KEY=

# --- Tier 1 (sub-4B models, cheap first pass — up to 5 concurrent slots,
# OMEGA_TIER1_MODEL_1..5 / _BASE_URL / _PROVIDER / _API_KEY). Any slot left
# unset is simply skipped; leave all of them unset to skip Tier 1
# entirely. ---
# OMEGA_TIER1_MODEL_1_BASE_URL=http://localhost:11434
# OMEGA_TIER1_MODEL_1=llama3.2:3b
OMEGA_TIER1_TIMEOUT_SECS=20

# --- Tier 2 (up to three ~9B models, sampled concurrently and trusted only
# if they agree with each other — OMEGA_TIER2_MODEL_1..3, same shape as
# Tier 1). Leave unset to skip Tier 2. ---
# OMEGA_TIER2_MODEL_1_BASE_URL=http://localhost:11434
# OMEGA_TIER2_MODEL_1=qwen2.5:7b
OMEGA_TIER2_TIMEOUT_SECS=60

# --- Tier 3 (the single-flight deliberate-cognition seat — the guaranteed
# backstop the rest of the ladder depends on). Leave unset and the daemon
# still runs, replying with an obvious placeholder instead of a real
# answer. ---
# OMEGA_TIER3_PROVIDER=ollama
# OMEGA_TIER3_BASE_URL=http://localhost:11434
# OMEGA_TIER3_MODEL=qwen2.5:14b
# OMEGA_TIER3_API_KEY=
OMEGA_TIER3_TIMEOUT_SECS=300

# --- Tier 4 (emergency escalation, biggest model you've got — used rarely,
# only when Tier 3's own confidence is still too low). Leave unset and
# escalation just falls back to the Tier 3 answer instead of failing. ---
# OMEGA_TIER4_PROVIDER=openai
# OMEGA_TIER4_BASE_URL=https://api.your-provider.example/v1
# OMEGA_TIER4_MODEL=some-large-model
# OMEGA_TIER4_API_KEY=
OMEGA_TIER4_TIMEOUT_SECS=300

# --- Attention specialist (v0.2 workspace protocol) ---
# Endpoint/model presence alone does not activate a specialist. `off` is
# the default: no model call or attention latency. `shadow` records paired
# votes without changing Working Memory; use it while evaluating a new
# adapter. `active` lets the model control admission and should be selected
# only after held-out plus live outcome validation, not self-confidence.
OMEGA_ATTENTION_MODE=off
# OMEGA_ATTENTION_MODEL_BASE_URL=http://127.0.0.1:11434
# OMEGA_ATTENTION_MODEL=your-trained-attention-model

# Optional local artifact produced by train_orient_outcome.py. The loader
# accepts held-out-gated `shadow_only` artifacts only; predictions are
# telemetry and never alter attention or actions.
# OMEGA_ORIENT_OUTCOME_MODEL_PATH=training/specialists/outputs/orient_outcome.json
# Held-out-gated, shadow-only Speak/Ask/Ignore classifier. It compares with
# the Executive's already-selected terminal operator and cannot control it.
# OMEGA_COMMUNICATIVE_INTENT_MODEL_PATH=training/specialists/outputs/communicative_intent.json

# --- Voice output (TTS) ---
# Points at a separate voice/TTS HTTP service you run yourself (this daemon
# never starts one for you). Leave unset to disable voice output entirely —
# a supported, silent no-op.
# OMEGA_VOICE_BASE_URL=http://127.0.0.1:8790
# OMEGA_VOICE_SPEAKER=Omega
# OMEGA_VOICE_CONVERSATION_ID=omega

# --- Video input (camera scene/entity events) ---
# Points at a separate camera-perception HTTP service you run yourself
# (for example, a separate local video service) - this daemon never starts one for you. Leave
# unset to disable video input entirely, a supported, silent no-op.
# OMEGA_VIDEO_BASE_URL=http://127.0.0.1:8797
# Also the client's poll interval - caps how often camera activity can
# compete for Working Memory, since (unlike speech) a camera has no natural
# turn-taking pace of its own. See crates/omega-acad/src/video.rs.
# OMEGA_VIDEO_MIN_INTERVAL_MS=1500

# --- Library reader (background reading of your own PDF library) ---
# Point this at a folder of your own PDFs to have them indexed into the
# Knowledge Library in the background, plus a "deliver next chunk" endpoint
# the viz app's "Deliver a Book" button uses. Leave unset to disable
# (default). If you do set it on Windows, use single quotes around the
# path in `.env` — the parser trips over raw backslashes otherwise.
# OMEGA_LIBRARY_PATH='C:\path\to\your\library'
# OMEGA_LIBRARY_CHUNK_CHARS=1500
# OMEGA_LIBRARY_KL_INTERVAL_SECS=1
