; Engine configuration file.
; It's best edited using the editor UI and not directly, since the parameters
; that go here are not all obvious.

config_version=5

[application]

config/name="Omega Mind Map"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ApiClient="*res://scripts/api_client.gd"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.05, 1)
textures/vram_compression/import_etc2_astc=true
